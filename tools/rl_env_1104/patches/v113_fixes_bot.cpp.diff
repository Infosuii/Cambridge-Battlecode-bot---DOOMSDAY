+bool Bot::retry_channel(ChannelRetry::Kind kind, vec2 altar) {
+    if (!channel_retry.matches(kind, pos.x, pos.y, altar.x, altar.y)) return true;
+    // A same-turn retry cannot have made progress. On a later turn use the same
+    // threat model as the cancellation guard, evaluated for a fresh channel.
+    if (channel_retry.round == round) return false;
+    float incoming = 0.0f;
+    for (const auto& e : w.enemies)
+        if (cheb(e.pos, pos) <= e.range + 2) incoming += e.strength + e.focus * 0.5f;
+    int duration = bc::constants::recall_time;
+    if (kind == ChannelRetry::submit) {
+        duration = std::max(bc::constants::submit_gem_minimum_duration,
+            bc::constants::submit_gem_base_duration + static_cast<int>(std::ceil(
+                static_cast<double>(gems) * bc::constants::submit_gem_duration_multiplier)));
+    } else {
+        const auto items = bc::self().item_count();
+        if (items[bc::item_type::home_emblem_of_strength] ||
+            items[bc::item_type::home_emblem_of_focus] ||
+            items[bc::item_type::home_emblem_of_health]) duration = 3;
+    }
+    bool unsafe = tune::kChannelGuard > 0.0f && incoming * static_cast<float>(duration + 1) * tune::kChannelGuard >= hp;
+#if A2_HIDEREC
+    if (kind == ChannelRetry::recall && hidden_here()) unsafe = false;
+#endif
+    return channel_retry.allows(kind, round, pos.x, pos.y, altar.x, altar.y, unsafe);
+}
+
+bool Bot::start_recall() {
+    if (!retry_channel(ChannelRetry::recall)) return false;
+    bc::self().recall();
+    return true;
+}
+
+bool Bot::start_submission(vec2 altar) {
+    if (!retry_channel(ChannelRetry::submit, altar)) return false;
+    bc::self().submit_gems(altar);
+    channel_altar = altar;
+    return true;
+}
