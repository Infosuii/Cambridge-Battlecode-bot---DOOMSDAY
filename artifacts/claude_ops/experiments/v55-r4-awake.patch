+        const int ci = find_camp(static_cast<std::uint32_t>(p.y * width + p.x) + 1);
+        if (ci >= 0 && camps[static_cast<std::size_t>(ci)].strength > 0) awake_cache.push_back(ci);
+    }
+    return awake_cache;
+}
