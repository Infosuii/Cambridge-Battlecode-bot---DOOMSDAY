+#if V55_AWAKE_EXACT
+const std::vector<int>& World::visible_awake_camps() const {
+    if (awake_cache_valid) return awake_cache;
+    awake_cache_valid = true;
+    awake_cache.clear();
+    // Personal vision only. Full-health members can be awake; injured camps can be asleep again.
+    const auto awake = bc::vision::camp_tiles() & ~bc::vision::asleep_camp_tiles();
