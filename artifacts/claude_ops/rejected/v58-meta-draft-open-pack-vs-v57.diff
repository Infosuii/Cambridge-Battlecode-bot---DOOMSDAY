diff -ru bots/v57/src/bot.cpp bots/v58/src/bot.cpp
--- bots/v57/src/bot.cpp	2026-10-25 20:48:53.979666000 +0000
+++ bots/v58/src/bot.cpp	2026-10-25 21:13:03.587077800 +0000
@@ -5090,6 +5090,37 @@
         return sole_gem_group;
     }
 #endif
+#if V58_OPEN_PACK
+    // Opening pack (Claudus Maximus, 80 decoded games: their first elk-size clear starts at round 21 with 3.7 champions
+    // and is captured at round 50; ours start at 36 with 2.7 and capture at 79; by round 250 they have taken 4.0 such
+    // groups for 655 gold against our 2.3 for 266). Every champion picks the same group from static data: the best
+    // value per spawn distance among elk-size groups on our side. Once per call, like A2_SOLE_GEM.
+    if (open_group == -2) {
+        open_group = -1;
+        float ex = 0, ey = 0, en = 0;
+        for (vec2 p : w.enemy_spawn.positions()) ex += static_cast<float>(p.x), ey += static_cast<float>(p.y), ++en;
+        float best_v = 0.0f;
+        for (std::size_t k = 0; en > 0 && k < w.groups.size(); ++k) {
+            const auto& g = w.groups[k];
+            if (g.harmless || g.camps.empty() || g.gems == 0 || g.max_hp < 2400.0f || g.max_hp > 6000.0f) continue;
+            const vec2 c = w.camps[static_cast<std::size_t>(g.camps[0])].pos;
+            const int d = fdist(w.spawn_field, c);
+            const float de = std::max(std::fabs(static_cast<float>(c.x) - ex / en), std::fabs(static_cast<float>(c.y) - ey / en));
+            if (d > 30 || static_cast<float>(d) >= 0.8f * de) continue;
+            const float v = (static_cast<float>(g.gems) + gold_weight() * static_cast<float>(g.gold)) / (static_cast<float>(d) + 15.0f);
+            if (v > best_v) best_v = v, open_group = static_cast<int>(k);
+        }
+    }
+    if (open_group >= 0) {
+        const auto& og = w.groups[static_cast<std::size_t>(open_group)];
+        if (round >= V58_OPEN_UNTIL || og.state == GroupState::respawning) open_group = -1; // captured: the opening is over
+        else if (og.state == GroupState::alive && hp >= max_hp * 0.5f && gems < tune::kTributeCarry) {
+            best_need = std::min(team_size, V58_OPEN_N);
+            best_score = 1e9f;
+            return open_group;
+        }
+    }
+#endif
 #if A2_GATE_JOB
     // Gated altars (boss-battle: every altar access tile holds a monolith camp, banking opens only while it is dead).
     // Carriers held 170-570 gems all game and never banked; top teams bank from round ~650. While the gate is shut,
