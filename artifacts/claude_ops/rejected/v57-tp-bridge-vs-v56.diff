+// V57_TP_BRIDGE: the field's next step is over a hole gap (a bridge tile) and walking has no way on. With a crystal,
+// hop to the landing tile within 3 that is closest to the goal; without one, go home to buy one (recall is free and
+// heals). Only with no visible enemy and outside awake-camp reach: stuns and death cancel the channel.
+bool Bot::tp_cross(const bc::distance_field& field) {
+    const int here = fdist(field, pos);
+    bool gap = false;
+    for (vec2 dir : kDirs) {
+        const vec2 h = pos + dir;
+        gap |= in_bounds(h, w.width, w.height) && bit(w.bridges, h) && fdist(field, h) < here;
+    }
+    if (!gap || !w.enemies.empty() || bit(w.hot_zone, pos)) return false;
+    auto& me = bc::self();
+    if (tp_held < 0) tp_held = static_cast<int>(me.consumables()[bc::consumable_type::tp_crystal].count());
+    if (tp_held <= 0) {
+        need_crystal = true;
+        return false;
+    }
+    vec2 best{-1, -1};
+    int best_d = here;
+    const bc::bitboard blocked = w.static_blocked | w.unit_tiles | w.hot_zone;
+    for (int dy = -3; dy <= 3; ++dy)
+        for (int dx = -3; dx <= 3; ++dx) {
+            const vec2 q{pos.x + dx, pos.y + dy};
+            if (!in_bounds(q, w.width, w.height) || bit(blocked, q)) continue;
+            const int d = fdist(field, q);
+            if (d < best_d) best_d = d, best = q;
+        }
+    if (best.x < 0) return false;
+    try {
+        if (me.consumables()[bc::consumable_type::tp_crystal].use(best)) {
+            tp_held = 0;
+            mode = "tp-cross";
+            return true;
+        }
+    } catch (const std::exception& e) {
+        LOG("tp cross error %s\n", e.what());
+        tp_held = 0;
+    }
+    return false;
+}
+#endif
