+        else {
+            LocalMask live;live.load(cambc::vision::camp_tiles());
+            const auto& job=world.groups[group];
+            for(unsigned k=0;k<job.tiles.size();++k) {
+                if(!live.test(job.tiles[k])||here.chebyshev_distance(job.tiles[k])>me.attack_range())continue;
+                const auto& camp=job.members()[k];
+                if(camp.is_visible()&&!camp.is_dead()){target=&camp;break;}
+            }
