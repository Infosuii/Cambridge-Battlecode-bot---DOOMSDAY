+        if(act.cast(reset)&&me.can_attack()&&act.attack(*target)) {
+#if DZ_ECONOMY_V2
+            mem.last_work=tc.round;
+#else
+            (void)mem;
+#endif
+#if DZ_TRACE
+            {TraceScope scope;trace("DZ_RESET_FOLLOWUP round=%u slot=%u group=%d tile=%d,%d\n",tc.round,world.slot,
+                group,target->spawn_position().x,target->spawn_position().y);}
+#endif
+            return true;
+        }
+    }
+    return false;
+}
