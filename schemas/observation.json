{
  "_owner": "agent C. Canonical observation schema. tools/gen_schema.py turns this file into bot/src/nn_schema.h and python/nfs/schema_gen.py; kObsSchemaHash = FNV-1a-32 of json.dumps(this, sort_keys=True, separators=(',',':'), ensure_ascii=True).",
  "name": "nfs_observation",
  "version": 1,
  "raw_version": 1,
  "raw_magic": 1396854606,
  "_raw_magic": "0x53424F4E = bytes 'NOBS' little-endian",
  "layout": "[self_global | ally rows (kAllyRows x kAllyDim) | ally mask (kAllyRows) | enemy rows (kEnemyRows x kEnemyDim) | enemy mask (kEnemyRows)]",
  "normalisation": "x = clip(raw * inv_scale, lo, hi), inv_scale = float32(1/scale); a non-finite raw*inv_scale becomes 0 BEFORE clipping. Padded rows (present == 0) are all zero with mask 0. Rows are sorted by (visible desc, position known desc, chebyshev distance asc, id asc) inside encode, so RawTurn row order never matters.",
  "rows": {
    "ally": {"K": 5, "why": "a team has at most 6 bodies (5 picks, Cassi & Issac are one pick and two bodies; bot.h kClaimSlots = 6), so 5 teammates besides self: every ally has a row, nothing is truncated."},
    "enemy": {"K": 6, "why": "one row per enemy body (at most 6, same rule). Enemy identities, types and alive flags are public; each row is that enemy's live observation when visible, else this champion's own last observation with its age, else position unknown."}
  },
  "coordinate_frame": {
    "rule": "Canonical team perspective. flip = our spawn centre lies in the 'high' half along the symmetry axis: horizontal: 2*cx > W-1; vertical: 2*cy > H-1; rotational180: 2*cx > W-1, or 2*cx == W-1 and 2*cy > H-1. Exactly on the axis (degenerate): flip = (absolute team == 1). Unknown symmetry value: no flip. 2*cx = own_spawn_x0 + own_spawn_x1 (inclusive bounding box).",
    "position": "flip applies the SDK map symmetry T: horizontal (x,y)->(W-1-x, y); vertical (x,y)->(x, H-1-y); rotational180 (x,y)->(W-1-x, H-1-y). T is an involution.",
    "vector": "displacements use the linear part L: horizontal (dx,dy)->(-dx,dy); vertical (dx,dy)->(dx,-dy); rotational180 (dx,dy)->(-dx,-dy). Relative positions are L(p - self) = T(p) - T(self).",
    "heading": "8 compass directions in common.h kDirs order (N=+y, NE, E, SE, S, SW, W, NW, index 0..7): horizontal d->(8-d)%8; vertical d->(4-d)%8 (mod 8); rotational180 d->(d+4)%8. Ability destinations/directions are vectors (L) or positions (T).",
    "equivalence": "On a map symmetric under T, team B's state mirrored by T encodes identically to team A's (tests/python/test_obs_transforms.py, tests/cpp/obs_parity.cpp). The flip itself is deliberately NOT a feature (it would be the only difference between the two views)."
  },
  "size_classes": {"small_max_area": 1600, "medium_max_area": 3600},
  "memory": {"max_age_rounds": 60, "why": "an entity last seen more than 60 rounds ago is treated as position unknown (its age feature already saturates at 32)."},
  "belief": {
    "n_sectors": 9,
    "definition": "training target only (never an input): sector of each enemy body in the canonical frame relative to self: 0..7 = compass octant (transforms.sector_of) within Chebyshev 16, 8 = farther or not on the board; label = enemy seen in that sector within the next 10 rounds by this champion. Owner C defines it; heads.json id 10."
  },
  "raw_turn": {
    "_doc": "Little-endian, every field 4 bytes (i32 'i', u32 'I', f32 'f'), no implicit padding. Offsets are static_asserted in nn_obs.h and unpacked by python/nfs/obs.py. Unknown integers are -1 unless stated.",
    "objective": [
      ["valid", "i"], ["group", "i"], ["anchor_x", "i"], ["anchor_y", "i"], ["dist_walk", "i"], ["dist_cheb", "i"],
      ["gems", "i"], ["gold", "i"], ["state", "i"], ["respawn_in", "i"], ["harmless", "i"], ["ally_claims", "i"],
      ["enemy_age", "i"], ["hp_left", "f"], ["max_hp", "f"]
    ],
    "ally": [
      ["present", "i"], ["handle", "I"], ["slot", "i"], ["type", "i"], ["alive", "i"], ["visible", "i"], ["known", "i"],
      ["age", "i"], ["x", "i"], ["y", "i"], ["range", "i"], ["gems", "i"], ["claim_code", "i"], ["claim_dist", "i"],
      ["claim_gems", "i"], ["hp", "f"], ["max_hp", "f"], ["strength", "f"], ["focus", "f"]
    ],
    "enemy": [
      ["present", "i"], ["handle", "I"], ["type", "i"], ["alive", "i"], ["visible", "i"], ["known", "i"], ["age", "i"],
      ["x", "i"], ["y", "i"], ["range", "i"], ["gems", "i"], ["state_bits", "i"], ["hp", "f"], ["max_hp", "f"],
      ["strength", "f"], ["focus", "f"]
    ],
    "turn": [
      ["magic", "I"], ["version", "I"], ["schema_hash", "I"], ["size", "I"],
      ["round", "i"], ["max_rounds", "i"], ["winning_gems", "i"], ["abs_team", "i"], ["my_handle", "I"], ["slot", "i"],
      ["team_size", "i"], ["enemy_count", "i"],
      ["width", "i"], ["height", "i"], ["symmetry", "i"], ["n_groups", "i"], ["fields_built", "i"], ["altar_ready", "i"],
      ["enemy_ready", "i"],
      ["own_spawn_x0", "i"], ["own_spawn_y0", "i"], ["own_spawn_x1", "i"], ["own_spawn_y1", "i"],
      ["enemy_spawn_x0", "i"], ["enemy_spawn_y0", "i"], ["enemy_spawn_x1", "i"], ["enemy_spawn_y1", "i"],
      ["alive", "i"], ["pos_x", "i"], ["pos_y", "i"], ["gems", "i"], ["gold", "i"], ["attack_range", "i"], ["type", "i"],
      ["state_bits", "i"], ["cast_done", "i"], ["heading_home", "i"], ["target_group", "i"], ["tribute_carry", "i"],
      ["ward_charges", "i"], ["ward_cooldown", "i"], ["spawn_dist", "i"], ["altar_dist", "i"], ["enemy_spawn_walk", "i"],
      ["in_bush", "i"], ["on_own_spawn", "i"], ["in_hot_zone", "i"], ["in_enemy_zone", "i"],
      ["spell_present", "i", 2], ["spell_kind", "i", 2], ["spell_cooldown", "i", 2], ["spell_range", "f", 2],
      ["hp", "f"], ["max_hp", "f"], ["prev_hp", "f"], ["strength", "f"], ["focus", "f"], ["items", "f"],
      ["camp_taken_mult", "f"], ["camp_dealt_mult", "f"],
      ["hist10_age", "i"], ["hist10_hp", "f"], ["hist10_gems", "i"],
      ["hist50_age", "i"], ["hist50_ally", "i"], ["hist50_enemy", "i"],
      ["hist200_age", "i"], ["hist200_ally", "i"], ["hist200_enemy", "i"],
      ["ally_score", "i"], ["enemy_score", "i"], ["alive_us", "i"], ["alive_them", "i"],
      ["ally_deaths_50", "i"], ["enemy_deaths_50", "i"], ["ally_deaths_total", "i"], ["enemy_deaths_total", "i"],
      ["vis_enemies", "i"], ["vis_allies", "i"], ["sight_n5", "i"], ["sight_n20", "i"], ["sight_x", "i"], ["sight_y", "i"],
      ["sight_age", "i"], ["distress_x", "i"], ["distress_y", "i"], ["distress_age", "i"], ["enemy_wards", "i"],
      ["obj", "objective", 4], ["ally", "ally", 5], ["enemy", "enemy", 6]
    ]
  },
  "visibility_classes": {
    "own": "this champion's own live state (SDK self queries / Bot snapshot refreshed this turn)",
    "ally-shared": "team shared memory (claims, sightings, distress) written by teammates",
    "visible-now": "read from the current vision (World::update this turn)",
    "remembered-with-age": "this champion's own earlier observation, always paired with its age feature",
    "static-map": "map geometry fixed for the game (SDK map queries cached in World::init)",
    "public": "engine information available to every bot regardless of vision: round, submitted gems, champion handles/types/alive flags, game constants",
    "derived": "deterministic function of features of the classes above (no additional information)"
  },
